(:room
 :id "tea-table"
 :title "Lawn and Tea Table"
 :body
 ((:p :text "Tea is laid under a wide tree. Emily Inglethorp rules the table kindly but completely; Alfred hovers near her; Evelyn Howard watches him with open contempt.")
  (:branch
   :when (:state :scope :global :key :clue-evie-warning)
   :then ((:p :text "Evelyn's warning about Alfred hangs in the air, blunt enough to seem honest."))
   :else nil)
  (:branch
   :when (:state :scope :global :key :clue-cynthia-dispensary)
   :then ((:p :text "Cynthia's dispensary work gives her brightness a sharper edge: she handles medicines every day."))
   :else nil)
  (:choice
   :options
   ((:option
     :label "Ask Evelyn why she distrusts Alfred"
     :id :styles-ask-evelyn
     :once t
     :do (:sequence
          :effects
          ((:set
            :target (:state :scope :global :key :clue-evie-warning)
            :value t)
           (:say :text "Evelyn says Alfred is a dangerous man, and says it as if contradiction would be indecent."))))
    (:option
     :label "Ask Cynthia about the dispensary"
     :id :styles-ask-cynthia-tea
     :once t
     :do (:sequence
          :effects
          ((:set
            :target (:state :scope :global :key :clue-cynthia-dispensary)
            :value t)
           (:say :text "Cynthia laughs about her work, but the names of drugs and poisons come easily to her."))))
    (:option
     :label "Ask Mary about poisons"
     :id :styles-ask-mary-poisons
     :once t
     :do (:sequence
          :effects
          ((:set
            :target (:state :scope :global :key :clue-mary-poison-talk)
            :value t)
           (:say :text "Mary speaks lightly of poisons, then notices Hastings noticing."))))
    (:option
     :label "Retire for the night"
     :do (:goto :room "night-crisis"))))))
