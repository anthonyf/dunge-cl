(:room
 :id "final-drawing-room"
 :title "Final Drawing Room"
 :body
 ((:p "Poirot arranges the room like a stage. The facts have not changed, but for the first time they may all point in one direction.")
  (:choice
   :options
   ((:option
     :label "Accuse Alfred Inglethorp and Evelyn Howard"
     :when (:and
            (:marked? :deduction-poison-in-medicine)
            (:marked? :deduction-chemist-purchase-staged)
            (:marked? :deduction-alfred-wanted-arrest)
            (:marked? :deduction-alfred-evelyn-conspiracy))
     :do (:go "ending-player-led"))
    (:option
     :label "Ask Poirot to complete the solution"
     :when (:and
            (:marked? :deduction-poison-in-medicine)
            (:marked? :deduction-chemist-purchase-staged)
            (:not (:marked? :deduction-alfred-evelyn-conspiracy)))
     :do (:go "ending-poirot-led"))
    (:option
     :label "Accuse John Cavendish"
     :do (:go "ending-wrong-accusation"))
    (:option
     :label "Accuse Alfred alone"
     :do (:go "ending-wrong-accusation"))))))
