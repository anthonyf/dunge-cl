(:room
 :id "suspect-board"
 :title "Suspect Board"
 :body
 ((:p "You spread the case across a table: names, motives, means, opportunities, contradictions, and questions that become sharper as the case darkens.")
  (:branch
   :when (:marked? :clue-evie-warning)
   :then ((:p "Evelyn: warning source, apparent enemy of Alfred, perhaps too forceful in her hatred."))
   :else ((:p "Evelyn: still mostly an impression, not a theory.")))
  (:branch
   :when (:marked? :deduction-poison-in-medicine)
   :then ((:p "Method: the regular medicine, not a freshly poisoned drink."))
   :else ((:p "Method: coffee, cocoa, and medicine still compete for attention.")))
  (:branch
   :when (:marked? :deduction-chemist-purchase-staged)
   :then ((:p "Alfred: suspicious, but the suspicious evidence is itself suspicious."))
   :else ((:p "Alfred: the obvious suspect, almost too obvious.")))
  (:choice "Return to Poirot" (:go "poirot"))))
