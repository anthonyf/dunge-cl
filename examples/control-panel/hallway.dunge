(:room
 :id "hallway"
 :title "Hallway"
 :body
 ((:p "You are in a long hallway.")

  (:entity
   :name "secret door"
   :id "secret-door"
   :state ((:open nil))
   :body
   ((:branch
     :when (:eq
            :left (:self :open)
            :right t)
     :then
     ((:p "A secret door stands open in the east wall.")
      (:choice "Enter the secret passage" (:go "hidden room"))))))

  (:entity
   :name "control panel"
   :id "panel"
   :state ((:switch :off)
           (:count 0))
   :refs ((:door "secret-door"))
   :body
   ((:p "A metal control panel is mounted beside the wall.")
    (:branch
     :when (:eq
            :left (:self :switch)
            :right :off)
     :then
     ((:p "The switch is down.")))
    (:branch
     :when (:eq
            :left (:self :switch)
            :right :on)
     :then
     ((:p "The switch is up.")))
    (:action
     :label "Flip the switch"
     :do
     ((:toggle
       :target (:self :switch))
      (:say "You flip the switch.")))
    (:action
     :label "Press the button"
     :do
     ((:if
       :when (:eq
              :left (:self :switch)
              :right :on)
       :then
       ((:set
         :target (:ref :door :open)
         :value t)
        (:say "Something heavy slides open nearby."))
       :else
       ((:say "The button clicks, but nothing happens.")))))))

  (:choice "Leave" (:quit))))
