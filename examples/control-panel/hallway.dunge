(:room
 :id "hallway"
 :title "Hallway"
 :body
 ((:p :text "You are in a long hallway.")

  (:entity
   :name "secret door"
   :id "secret-door"
   :state ((:open nil))
   :body
   ((:branch
     :when (:eq
            :left (:state :scope :self :key :open)
            :right t)
     :then
     ((:p :text "A secret door stands open in the east wall.")
      (:choice
       :options
       ((:option
         :label "Enter the secret passage"
         :do (:goto :room "hidden room"))))))))

  (:entity
   :name "control panel"
   :id "panel"
   :state ((:switch :off)
           (:count 0))
   :refs ((:door "secret-door"))
   :body
   ((:p :text "A metal control panel is mounted beside the wall.")
    (:branch
     :when (:eq
            :left (:state :scope :self :key :switch)
            :right :off)
     :then
     ((:p :text "The switch is down.")))
    (:branch
     :when (:eq
            :left (:state :scope :self :key :switch)
            :right :on)
     :then
     ((:p :text "The switch is up.")))
    (:action
     :label "Flip the switch"
     :do
     ((:toggle
       :target (:state :scope :self :key :switch))
      (:say :text "You flip the switch.")))
    (:action
     :label "Press the button"
     :do
     ((:if
       :when (:eq
              :left (:state :scope :self :key :switch)
              :right :on)
       :then
       ((:set
         :target (:state :scope :ref :role :door :key :open)
         :value t)
        (:say :text "Something heavy slides open nearby."))
       :else
       ((:say :text "The button clicks, but nothing happens.")))))))

  (:choice
   :options
   ((:option :label "Leave" :do (:quit))))))
