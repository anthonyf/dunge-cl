(:room
 :id "threshold"
 :title "The White Arch"
 :body
 ((:p "The arch is smooth, pale, and cold. The dungeon beyond it should eventually be generated by Common Lisp from Dunge-authored tables.")
  (:branch
   :when (:marked? :first-room-generated)
   :then
   ((:p "A first chamber has already been sketched into the run log. Returning to it should recall the same generated instance once that system exists.")))
  (:choice
   "Sketch the first generated chamber"
   ((:inc :target (:state :scope :global :key :rooms-generated))
    (:inc :target (:state :scope :global :key :dungeon-depth))
    (:mark :first-room-generated)
    (:say "For now, the generated chamber is a placeholder room. Later this choice should call the room-instancing procedure.")
    (:go "placeholder-room"))
   :id :sketch-first-room
   :once t
   :when (:not (:marked? :first-room-generated)))
  (:choice
   "Return to the remembered chamber"
   (:go "placeholder-room")
   :when (:marked? :first-room-generated))
  (:choice "Return to camp" (:go "camp"))))
