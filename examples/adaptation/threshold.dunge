(:room
 :id "threshold"
 :title "The White Arch"
 :body
 ((:p "The arch is smooth, pale, and cold. The dungeon beyond it is generated by Common Lisp from Dunge-authored tables in the adaptation helper.")
  (:branch
   :when (:marked? :first-room-generated)
   :then
   ((:p "A first chamber has already been sketched into the run log. The CL adaptation helper can now recall that same generated instance.")))
  (:choice
   "Sketch the first generated chamber"
   ((:inc :target (:state :scope :global :key :rooms-generated))
    (:inc :target (:state :scope :global :key :dungeon-depth))
    (:mark :first-room-generated)
    (:say "This authored path still enters the placeholder room. The CL helper now demonstrates the room-instancing procedure outside the .dunge script.")
    (:go "placeholder-room"))
   :id :sketch-first-room
   :once t
   :when (:not (:marked? :first-room-generated)))
  (:choice
   "Return to the remembered chamber"
   (:go "placeholder-room")
   :when (:marked? :first-room-generated))
  (:choice "Return to camp" (:go "camp"))))
