(:room
 :id "entrance"
 :title "Entrance"
 :body
 ((:p "You stand at the entrance of a dark dungeon.")
  (:container
   :name "chest"
   :description "You see a chest in the corner of the room."
   :open "Open the chest"
   :close "Close the chest"
   :contents
   ((:item :name "A brass key")
    (:item :name "A sword")))
  (:choice "Enter the dungeon" (:go "hallway"))
  (:choice "Leave" (:quit))))
